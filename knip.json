{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.js"],
      "project": ["*.js", "scripts/*.js"]
    },
    "packages/build": {
      "entry": ["src/build.ts", "src/build-static.ts", "src/computeNodeModulesCacheKey.ts", "src/dev.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/e2e": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/embeds-worker": {
      "entry": ["src/embedsWorkerMain.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/memory": {
      "entry": ["src/measureMemory.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/server": {
      "entry": ["src/postinstall.js"],
      "project": ["src/**/*.js"],
      "ignoreDependencies": ["@lvce-editor/server"]
    }
  }
}
